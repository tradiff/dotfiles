-- vim: se ft=psql :

\pset pager always
-- Prefer pspg, but retain the previous less setup when it is unavailable.
\set has_pspg `command -v pspg >/dev/null 2>&1 && printf true || printf false`
\if :has_pspg
\setenv PSQL_PAGER 'pspg --no-mouse --ignore-case --quit-if-one-screen --reprint-on-exit --less-status-bar --style=0'
\else
\setenv PSQL_PAGER 'less --ignore-case --LONG-PROMPT --quit-if-one-screen --no-init --chop-long-lines --tabs=4'
\endif
\unset has_pspg

\set QUIET 1

\timing
--\x auto

-- table frame borders
\pset border 2
\pset linestyle unicode

-- By default, NULL is an empty space. This makes NULL values visible.
\pset null (null)

\set COMP_KEYWORD_CASE upper

-- Use a separate history file per-database.
\set HISTFILE ~/.psql_history- :DBNAME
-- If a command is run more than once in a row, only store it once in the history.
\set HISTCONTROL ignoredups
\set HISTSIZE 2000
-- \set VERBOSITY verbose

\set all 'select * from'
\set extensions 'select * from pg_available_extensions;'
\set version 'select version();'

-- Use :plain or :pretty to toggle formatting
\set plain '\\pset border 0 \\pset pager off'
\set pretty '\\pset border 2 \\pset pager on'


\set PROMPT1 '\n%[%033[1;31m%]➤ %[%033[1;36m%]%n%[%033[34m%]@%[%033[1;36m%]%M:%>%[%033[1;33m%]/%/ %[%033[1;31m%]%x %[%033[K%]%[%033[0m%]\n%[%033[1;33m%]%R%#%[%033[0m%] '
\set PROMPT2 '%[%033[1;33m%]%R%#%[%033[0m%] '

\set QUIET 0
